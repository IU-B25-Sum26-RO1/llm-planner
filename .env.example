HOST_VOSK_MODELS_PATH=./models

VOSK_MODEL=vosk-model-small-ru-0.22
AUDIO_SAMPLERATE=16000
AUDIO_BLOCK_SIZE=4000
HOST_PULSE_SOCKET_PATH=/run/user/1000/pulse/native
PULSE_SERVER=unix:/mnt/wslg/PulseServer
AUDIO_DEVICE=default

LLM_API_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=not-needed
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
SYS_PROMPT_PATH=/workspace/prompts/decomposer_system_prompt.txt

DISPLAY=:0
WAYLAND_DISPLAY=wayland-0
XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir
LD_LIBRARY_PATH=/usr/lib/wsl/lib
MESA_D3D12_DEFAULT_ADAPTER_NAME=NVIDIA
LIBGL_ALWAYS_SOFTWARE=1
TARGET_VIDEO_FPS=10
TARGET_VIDEO_WIDTH=640
TARGET_VIDEO_HEIGHT=480

CAMERA_RAW_TOPIC=/camera/color/image_raw

SAM3_SERVER_URL=ws://host.docker.internal:8120/websocket

# Target source for TaskManager:
# auto       - use fresh /perception/target_pose if available, otherwise Gazebo fallback.
# perception - require /perception/target_pose and fail without deterministic fallback.
# simulation - use deterministic Gazebo model-state lookup through scene_object_resolver.
TARGET_SOURCE_MODE=auto
# Main scene camera:
# /camera/camera/image_raw
# /camera/camera/depth/image_raw
# /camera/camera/camera_info
#
# Front overview test camera:
# /front_camera/camera/image_raw
# /front_camera/camera/depth/image_raw
# /front_camera/camera/camera_info
PERCEPTION_IMAGE_TOPIC=/front_camera/camera/image_raw
PERCEPTION_DEPTH_TOPIC=/front_camera/camera/depth/image_raw
PERCEPTION_CAMERA_INFO_TOPIC=/front_camera/camera/camera_info
PERCEPTION_TARGET_TOPIC=/to_track/target
PERCEPTION_DETECTIONS_TOPIC=/perception/detections
PERCEPTION_TARGET_POSE_TOPIC=/perception/target_pose
PERCEPTION_DEBUG_IMAGE_TOPIC=/perception/debug_image
PERCEPTION_WORLD_FRAME=world
PERCEPTION_DEVICE=cpu
PERCEPTION_MAX_FPS=3.0
PERCEPTION_TARGET_TIMEOUT=5.0
YOLO_CONFIG_DIR=/workspace/models
XDG_CACHE_HOME=/workspace/models/.cache
YOLO_WORLD_MODEL=/workspace/models/yolov8s-worldv2.pt
YOLO_CONF=0.01
